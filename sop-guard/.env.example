# SOP-Guard Configuration

# Environment
ENVIRONMENT=development

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./sop_guard.db
# DATABASE_URL=postgresql+asyncpg://sopguard:password@localhost:5432/sopguard

# LLM Provider (mock for demo, ollama for local, openai for production)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=http://localhost:11434

# Embeddings
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_BACKEND=auto
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Voice
WHISPER_MODE=mock

# Security
SECRET_KEY=change-this-in-production
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
DEBUG=true
