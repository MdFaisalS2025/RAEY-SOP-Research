# Meridian Configuration
# Research prototype - NOT for clinical use. Copy this file to `.env` in
# sop-guard/backend/ (backend) and/or sop-guard/frontend/ (frontend) and fill
# in the values you need. Every variable below has a safe default in code if
# left unset, EXCEPT the ones marked (required for production).

# ============================================================
# BACKEND (sop-guard/backend/.env)
# ============================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for dev/demo - auto-created and auto-seeded on startup.
# For durable production storage, point this at managed PostgreSQL instead.)
DATABASE_URL=sqlite+aiosqlite:///./meridian.db
# DATABASE_URL=postgresql+asyncpg://sopguard:password@localhost:5432/sopguard

# LLM Provider - in-house only, no patient/query data ever leaves this
# deployment. mock = template answers, no model required (default, works
# with zero setup). ollama = local/self-hosted model.
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434

# Embeddings / retrieval
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_BACKEND=auto
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector DB (optional - falls back to in-memory/TF-IDF if unset)
QDRANT_URL=
QDRANT_API_KEY=

# Voice transcription
WHISPER_MODE=mock

# External evidence: OpenEvidence (architecture-ready placeholder - see
# app/integrations/openevidence.py). No public OpenEvidence API exists for
# this project; leaving these unset is expected and the provider reports
# "not_configured" rather than fabricating results. PubMed, Europe PMC, CDC,
# WHO, ClinicalTrials.gov, FDA, MedlinePlus, and CMS require no API key.
OPENEVIDENCE_API_KEY=
OPENEVIDENCE_BASE_URL=
OPENEVIDENCE_ORG_ID=

# Security (required for production)
SECRET_KEY=change-this-in-production
# JSON array or comma-separated list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# ============================================================
# FRONTEND (sop-guard/frontend/.env.local)
# ============================================================

# Public base URL the browser uses for API calls (lib/api.ts). Leave empty
# for local dev / same-origin deployments - requests then go through the
# Next.js rewrite proxy (see BACKEND_URL below). Set to the backend's public
# URL when frontend and backend are deployed on different domains (e.g.
# Vercel + Render): NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=

# Server-side-only rewrite target (next.config.js) - most of the app calls
# relative /api/... paths that rely on this proxy rather than
# NEXT_PUBLIC_API_URL above. Must also point at the backend's public URL in
# any deployment where frontend and backend aren't on the same host.
BACKEND_URL=http://localhost:8000

# Institution's PolicyTech tenant URL (optional). PolicyTech is Moffitt's
# real policy/procedure management system - Meridian doesn't ingest from it
# (no live SOP-import connector exists), but if an institution's PolicyTech
# portal URL is configured here, an honest "Open PolicyTech Portal" external
# link appears on answers. Left unset, no link is shown - no deep-link path
# is guessed, since PolicyTech's per-document URL scheme isn't knowable
# without a real tenant to test against.
NEXT_PUBLIC_POLICYTECH_BASE_URL=

# Experimental OpenEvidence query-URL template (optional, off by default).
# OpenEvidence has no officially documented URL parameter for prefilling a
# question - their user-guide pages are bot-gated, and the only known one
# (?oe_q=) is implemented by a third-party browser extension's injected
# content script, not by openevidence.com itself. Without this set, the
# "Open in OpenEvidence" action copies the question to the clipboard and
# opens their site in a new tab (Option B - honest, always works). If your
# institution's users run that extension, or OpenEvidence ever ships an
# official query URL, set a template here with a {query} placeholder (e.g.
# "https://www.openevidence.com/search?oe_q={query}") to link directly
# instead. Never presented as an "integration" either way.
NEXT_PUBLIC_OPENEVIDENCE_URL_TEMPLATE=
