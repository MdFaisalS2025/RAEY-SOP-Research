# Meridian backend configuration.
# Research prototype - NOT for clinical use.
#
# In-house model policy: by default this app never calls a third-party LLM
# API - patient and query data stays on infrastructure the hospital
# controls. Three LLM_PROVIDER values exist:
#   ollama - self-hosted local model via https://ollama.com (recommended, default)
#   mock   - deterministic template answers, no model at all (offline demo)
#   groq   - opt-in hosted inference for faster demo output; requires
#            GROQ_API_KEY below. Query/answer text DOES leave the local
#            network with this provider - do not use with real patient data.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# A single local Ollama process serializes inference - concurrent requests
# contend rather than parallelize and can fail outright. Raise this only if
# LLM_BASE_URL points at infrastructure that can actually serve concurrent
# inference (e.g. a scaled endpoint), not a single local `ollama serve`.
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_MAX_RETRIES=2

# LLM_PROVIDER=mock   # uncomment to run fully offline with no model

# LLM_PROVIDER=groq   # uncomment along with GROQ_API_KEY below for faster demo output
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- RAG retrieval ---
# Sparse (lexical) scoring: "tfidf" (default, hand-rolled) or "bm25"
# (rank-bm25's BM25Okapi - saturating term frequency + document-length
# normalization, a real ranking-function upgrade over plain TF-IDF).
RAG_SPARSE_BACKEND=tfidf

# How sparse and dense (embedding) scores combine: "weighted" (default,
# raw-score blend) or "rrf" (reciprocal rank fusion - combines each
# signal's rank instead of raw scores, no score-scale assumption needed;
# the standard production choice for hybrid retrieval).
RAG_FUSION=weighted

# --- Privacy / PHI guard ---
# Detects likely patient identifiers in a question before it reaches the model
# (see app/privacy/phi_guard.py). "rule" is a fast, dependency-free regex
# heuristic and is the default. "openmed" is a documented extension point for
# an OpenMed-based clinical NER adapter that is NOT bundled here - selecting it
# degrades gracefully back to the rule provider with a logged warning.
PHI_PROVIDER_BACKEND=rule

DEBUG=false
