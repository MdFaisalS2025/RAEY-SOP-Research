# Meridian backend configuration.
# Research prototype - NOT for clinical use.
#
# In-house model policy: this app never calls a third-party LLM API
# (OpenAI, Anthropic, Groq, Gemini, etc). Patient and query data stays on
# infrastructure the hospital controls. Only two LLM_PROVIDER values exist:
#   ollama - self-hosted local model via https://ollama.com (recommended)
#   mock   - deterministic template answers, no model at all (offline demo)

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# LLM_PROVIDER=mock   # uncomment to run fully offline with no model

DEBUG=false
