{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "sop-guard/frontend", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8010", "--app-dir", "sop-guard/backend"],
      "port": 8010
    }
  ]
}
